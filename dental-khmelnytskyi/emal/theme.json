{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "760px", "wideSize": "1200px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "name": "Пісок", "color": "#f7f3ed" },
				{ "slug": "surface", "name": "Білий", "color": "#ffffff" },
				{ "slug": "mint", "name": "Мʼята", "color": "#dcefe9" },
				{ "slug": "primary", "name": "Бірюза", "color": "#1d6b64" },
				{ "slug": "primary-dark", "name": "Глибока бірюза", "color": "#134a45" },
				{ "slug": "contrast", "name": "Чорнило", "color": "#15302d" },
				{ "slug": "muted", "name": "Сірий текст", "color": "#4d625f" },
				{ "slug": "coral", "name": "Корал", "color": "#e2725b" },
				{ "slug": "line", "name": "Лінія", "color": "#dcd5c9" }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "clamp(1.25rem, 2.5vw, 1.75rem)" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 7vw, 5.5rem)" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontSizes": [
				{ "slug": "small", "name": "Малий", "size": "0.9rem" },
				{ "slug": "medium", "name": "Звичайний", "size": "1.0625rem" },
				{ "slug": "large", "name": "Великий", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
				{ "slug": "x-large", "name": "Заголовок", "size": "2.25rem", "fluid": { "min": "1.6rem", "max": "2.25rem" } },
				{ "slug": "xx-large", "name": "Гігант", "size": "3.6rem", "fluid": { "min": "2.1rem", "max": "3.6rem" } }
			],
			"fontFamilies": [
				{
					"slug": "body", "name": "Onest", "fontFamily": "Onest, system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Onest", "fontWeight": "400 700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/onest-cyrillic.woff2" ], "unicodeRange": "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116" },
						{ "fontFamily": "Onest", "fontWeight": "400 700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/onest-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
					]
				},
				{
					"slug": "heading", "name": "Lora", "fontFamily": "Lora, Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Lora", "fontWeight": "400 700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/lora-cyrillic.woff2" ], "unicodeRange": "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116" },
						{ "fontFamily": "Lora", "fontWeight": "400 700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/lora-latin.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
					]
				}
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
		"spacing": {
			"blockGap": "1.25rem",
			"padding": { "left": "max(1rem, 4vw)", "right": "max(1rem, 4vw)" }
		},
		"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.6" },
		"elements": {
			"heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "600", "lineHeight": "1.15" } },
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "letterSpacing": "-0.01em" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				":hover": { "color": { "text": "var(--wp--preset--color--primary-dark)" } },
				":focus": { "outline": { "color": "var(--wp--preset--color--coral)", "offset": "3px", "style": "solid", "width": "3px" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--primary)", "text": "#ffffff" },
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "0.85rem", "bottom": "0.85rem", "left": "1.6rem", "right": "1.6rem" } },
				"typography": { "fontWeight": "600", "fontSize": "1rem" },
				":hover": { "color": { "background": "var(--wp--preset--color--primary-dark)" } },
				":focus": { "outline": { "color": "var(--wp--preset--color--coral)", "offset": "3px", "style": "solid", "width": "3px" } }
			}
		},
		"blocks": {
			"core/navigation": { "typography": { "fontSize": "1rem", "fontWeight": "500" } },
			"core/details": { "border": { "bottom": { "color": "var(--wp--preset--color--line)", "width": "1px", "style": "solid" } }, "spacing": { "padding": { "top": "1rem", "bottom": "1rem" } } },
			"core/table": { "typography": { "fontSize": "1rem" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Шапка", "area": "header" },
		{ "name": "footer", "title": "Футер", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-wide", "title": "Сторінка без заголовка (лендінг)", "postTypes": [ "page" ] }
	]
}
